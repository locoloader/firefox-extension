{
  "name": "Locoloader",
  "description": "Add extra powers⚡ to Locoloader.com!",
  "version": "1.7.9",
  "manifest_version": 3,
  "permissions": [
    "tabs",
    "downloads",
    "declarativeNetRequest",
    "storage",
    "scripting",
    "management"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.locoloader.com/*",
        "https://www.locoloader.test/*"
      ],
      "js": ["extension.js", "content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{21368c2e-1e43-414c-9c63-e1b87782681f}",
      "data_collection_permissions": {
        "required": [
          "websiteContent"
        ],
        "optional": []
      }
    }
  }
}